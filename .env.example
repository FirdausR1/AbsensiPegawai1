APP_NAME="Absensi Pegawai"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_app
DB_USERNAME=root
DB_PASSWORD=

# ==== Google Sheets / Google Cloud Service Account ====
# 1. Buka https://console.cloud.google.com -> buat project baru
# 2. Aktifkan "Google Sheets API" dan "Google Drive API"
# 3. Buat Service Account -> generate key (JSON) -> simpan file JSON ini
#    di storage/app/google/service-account.json (JANGAN commit ke git)
# 4. Share Google Spreadsheet-nya ke email service account tsb sebagai Editor
#    (email-nya ada di dalam file JSON, formatnya: xxx@xxx.iam.gserviceaccount.com)
GOOGLE_SERVICE_ENABLED=true
GOOGLE_SHEETS_APPLICATION_CREDENTIALS_PATH=storage/app/google/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=1MXiaSpfnzCZRI6dq1ptTCGiiXqcEpfr_

# ==== Kalender Libur Nasional Indonesia ====
# Menggunakan Nager.Date public API (gratis, tanpa API key)
HOLIDAY_API_URL=https://date.nager.at/api/v3/PublicHolidays
HOLIDAY_COUNTRY_CODE=ID
